#include "Cmm.h"

// -----------------------------------------------------------------------
// Key encoding
//
// Thread IDs are StgWord32, occupying the low 32 bits of each key slot.
// Two flag bits sit above the ID:
//
//   bit 32, DETACHED: set when the user detaches a context, cleared on
//     re-attach. The probe masks this bit when comparing against the
//     target tid and encodes the detached state in the return value so
//     the Haskell side never touches the value array for detached slots.
//
//   bit 33, CLAIMING: set by the owner between CAS-ing the key and
//     writing the value slot (see claimAndPublish in Storage.hs). A slot
//     in this state is treated as *not matching* -- the probe keeps
//     walking -- so a key is never observed paired with a value that
//     has not been written for it yet.
//
// Slot hashing uses a Fibonacci/golden-ratio multiplicative hash
// to spread sequential thread IDs across cache lines, avoiding false
// sharing on the key and value arrays.
//
// -----------------------------------------------------------------------
// Reading a (key, value) pair
//
// A key and its value are two words written separately, so a reader
// must snapshot them consistently. Every pair read here is a seqlock:
//
//     key   = load_acquire(keys[slot])
//     ref   = load_acquire(vals[slot])
//     key2  = load(keys[slot])
//     retry unless key2 == key
//
// The two acquire loads order the three loads (key <= ref <= key2) on
// weakly ordered hardware without a full fence; on x86 they are plain
// moves. Since a slot cannot change hands without its key passing
// through CLAIMING or TOMBSTONE, and every publication bumps the version
// bits, key2 == key means `ref` was the value published for `key` -- even
// if the slot was recycled back to the same tid in between.
// -----------------------------------------------------------------------

#define HASH_SALT     0x9E3779B97F4A7C15
#define DETACHED_BIT  0x0000000100000000
#define CLAIMING_BIT  0x0000000200000000
#define KEY_MASK      0x00000000FFFFFFFF
// Bits 34..62 hold a per-slot publication counter; see Storage.hs. The
// probes compare whole words, so it participates in the seqlock check
// automatically and closes the same-tid ABA case.

#define KEY_ADDR(keys, slot) ((keys) + SIZEOF_StgArrBytes   + WDS(slot))
#define VAL_ADDR(vals, slot) ((vals) + SIZEOF_StgMutArrPtrs + WDS(slot))

// -----------------------------------------------------------------------
// stg_getCurrentThreadId
//
// Returns the current green thread's ID as an Int#.
// Reads StgTSO_id(CurrentTSO) directly, with no myThreadId# box
// allocation, no rts_getThreadId FFI call.
// -----------------------------------------------------------------------

stg_getCurrentThreadId()
{
    return (TO_W_(StgTSO_id(CurrentTSO)));
}


// -----------------------------------------------------------------------
// stg_readSlot
//
// Consistent (key, value) snapshot of one slot; see the note above.
//
// Arguments:
//   P_ keys  : MutableByteArray# of Int-sized keys
//   P_ vals  : MutableArray# of IORef values
//   W_ slot  : index
//
// Returns: (Int# key, P_ ref)
// -----------------------------------------------------------------------

stg_readSlot(P_ keys, P_ vals, W_ slot)
{
    W_ key, key2;
    P_ ref;

  again:
    (key) = prim %load_acquire64(KEY_ADDR(keys, slot));
    (ref) = prim %load_acquire64(VAL_ADDR(vals, slot));
    key2 = W_[KEY_ADDR(keys, slot)];
    if (key2 != key) {
        goto again;
    }
    return (key, ref);
}


// -----------------------------------------------------------------------
// stg_probeThreadSlot
//
// Fused thread ID retrieval + multiplicative-hash linear probe + value
// read.
//
// Arguments:
//   P_ keys  : MutableByteArray# holding Int-sized keys per slot
//   P_ vals  : MutableArray# holding the IORef per slot
//   W_ mask  : table capacity - 1 (for bitwise AND)
//
// Returns: (Int# tid, Int# slot, Int# key, P_ ref)
//   slot >= 0   -> entry found and attached at that index; key is the
//                  full key word observed there and ref its value, read
//                  consistently with that key
//   slot == -1  -> entry not found; key is 0, ref a placeholder (keys)
//   slot <= -2  -> entry found but detached; real index = -(slot+2);
//                  key is the observed word (CAS against it to
//                  re-attach), ref a placeholder (keys)
// -----------------------------------------------------------------------

stg_probeThreadSlot(P_ keys, P_ vals, W_ mask)
{
    W_ tid, home, slot, key, key2, raw_key;
    P_ ref;

    tid  = TO_W_(StgTSO_id(CurrentTSO));
    home = (tid * HASH_SALT) & mask;
    slot = home;

  again:
    (key) = prim %load_acquire64(KEY_ADDR(keys, slot));
    raw_key = key & KEY_MASK;

    if (raw_key == tid) {
        if ((key & CLAIMING_BIT) != 0) {
            // Owner is mid-write; invisible until published.
            goto next;
        }
        if ((key & DETACHED_BIT) != 0) {
            // Key matches but detached bit is set.
            return (tid, 0 - slot - 2, key, keys);
        }
        (ref) = prim %load_acquire64(VAL_ADDR(vals, slot));
        key2 = W_[KEY_ADDR(keys, slot)];
        if (key2 != key) {
            // Slot changed under us; re-examine it from scratch.
            goto again;
        }
        return (tid, slot, key, ref);
    }

    if (key == 0) {
        return (tid, -1, 0, keys);
    }

  next:
    slot = (slot + 1) & mask;
    if (slot != home) {
        goto again;
    }

    return (tid, -1, 0, keys);
}


// -----------------------------------------------------------------------
// stg_probeSlotByKey
//
// Linear probe with an explicit key (not CurrentTSO), plus value read.
// Used by lookupRaw / updateRaw / adjustOnThread.
//
// Arguments:
//   P_ keys  : MutableByteArray# holding Int-sized keys per slot
//   P_ vals  : MutableArray# holding the IORef per slot
//   W_ mask  : table capacity - 1
//   W_ tid   : the raw key to search for (lower 32 bits only)
//
// Returns: (Int# slot, Int# key, P_ ref)  (same encoding as stg_probeThreadSlot)
// -----------------------------------------------------------------------

stg_probeSlotByKey(P_ keys, P_ vals, W_ mask, W_ tid)
{
    W_ home, slot, key, key2, raw_key;
    P_ ref;

    home = (tid * HASH_SALT) & mask;
    slot = home;

  again:
    (key) = prim %load_acquire64(KEY_ADDR(keys, slot));
    raw_key = key & KEY_MASK;

    if (raw_key == tid) {
        if ((key & CLAIMING_BIT) != 0) {
            goto next;
        }
        if ((key & DETACHED_BIT) != 0) {
            return (0 - slot - 2, key, keys);
        }
        (ref) = prim %load_acquire64(VAL_ADDR(vals, slot));
        key2 = W_[KEY_ADDR(keys, slot)];
        if (key2 != key) {
            goto again;
        }
        return (slot, key, ref);
    }

    if (key == 0) {
        return (-1, 0, keys);
    }

  next:
    slot = (slot + 1) & mask;
    if (slot != home) {
        goto again;
    }

    return (-1, 0, keys);
}
