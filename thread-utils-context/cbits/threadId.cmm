#include "Cmm.h"

// -----------------------------------------------------------------------
// Key encoding
//
// Each key slot is 64 bits on every target. The top four bits are flags
// and the low 60 hold the thread ID (StgThreadID, a 64-bit counter).
//
//   TOMBSTONE (bit 63): the whole word once a slot's entry is removed. A
//     tombstoned slot is never reused within its table; only a rehash
//     reclaims it.
//
//   CLAIMING (bit 62): set by a writer between CAS-ing the key and
//     publishing it (see claimAndPublish in Storage.hs). A slot is only
//     claimed from a state with no attached value, so a probe reads a
//     claim in flight as a miss (see PROBE_BODY).
//
//   DETACHED (bit 61): set when the user detaches a context, cleared on
//     re-attach. The probes encode it in their return value, along with
//     the entry's MutVar#, so re-attaching needs no further cell read.
//
//   FROZEN (bit 60): set on every slot of a table that is being rehashed.
//     No writer CASes from a frozen word, so a frozen table never changes
//     again; probes ignore the bit, so readers still see its entries.
//
// Slot hashing uses a Fibonacci/golden-ratio multiplicative hash
// to spread sequential thread IDs across cache lines, avoiding false
// sharing on the key and cell arrays.
//
// -----------------------------------------------------------------------
// Cells
//
// A slot's value is a cell: a weak pointer keyed on the owning thread's
// TSO whose value is the MutVar# holding the user's data. While the
// thread is alive the cell keeps the MutVar# alive; once the TSO is
// unreachable the GC marks the cell dead and stops retaining the MutVar#,
// so the user's data is released at that GC. Empty and tombstoned slots
// hold the map's dead cell.
//
// Within one table a slot's thread ID never changes once claimed: the
// slot goes 0 -> tid|CLAIMING -> tid <-> tid|DETACHED, and finally to
// TOMBSTONE. So once a probe has seen `tid`, the cell it reads is one of
// tid's own cells or a dead one, never another thread's. The key is read
// with acquire semantics so that the cell written before the key was
// published is visible; on x86 that is a plain move.
//
// The probes below need a single-instruction 64-bit acquire load, so they
// exist only on 64-bit targets. 32-bit targets use the portable Haskell
// probes in Storage.hs and only need stg_getCurrentThreadId and
// stg_cellOwner.
// -----------------------------------------------------------------------

#define HASH_SALT       0x9E3779B97F4A7C15
#define CLAIMING_BIT    0x4000000000000000
#define DETACHED_BIT    0x2000000000000000
#define FROZEN_BIT      0x1000000000000000
#define KEY_MASK        0x0FFFFFFFFFFFFFFF

#define KEY_ADDR(keys, slot)   ((keys)  + SIZEOF_StgArrBytes   + WDS(slot))
#define CELL_ADDR(cells, slot) ((cells) + SIZEOF_StgMutArrPtrs + WDS(slot))

// -----------------------------------------------------------------------
// stg_getCurrentThreadId
//
// Returns the current green thread's ID as an Int#.
// Reads StgTSO_id(CurrentTSO) directly, with no myThreadId# box
// allocation, no rts_getThreadId FFI call.
// -----------------------------------------------------------------------

stg_getCurrentThreadId()
{
    return (TO_W_(StgTSO_id(CurrentTSO)));
}


import CLOSURE stg_WEAK_info;
import CLOSURE stg_WHITEHOLE_info;

// -----------------------------------------------------------------------
// stg_cellOwner
//
// Who owns a cell, for purgeDeadThreads. The cell's weak key is the
// owning thread's TSO, so its state can be read directly, with no
// listThreads snapshot (which misses threads in the non-moving heap).
//
// Returns: (Int# status, W_ owner_id)
//   status 0 -> cell dead (or being killed); owner_id is 0
//   status 1 -> owner still running
//   status 2 -> owner finished or killed
//   owner_id is the owner's thread ID (its low word on 32-bit targets)
//
// Only fields are read and no pointer escapes, so there is no safepoint
// for the TSO to move under us and no need for a non-moving read barrier.
// A stale what_next merely delays the purge of a thread that just ended.
// -----------------------------------------------------------------------

stg_cellOwner(P_ cell)
{
    W_ info, what;
    P_ tso;

    info = GET_INFO_ACQUIRE(cell);
    if (info != stg_WEAK_info) {
        return (0, 0);
    }
    tso = StgWeak_key(cell);
    what = TO_W_(StgTSO_what_next(tso));
    if (what == ThreadComplete || what == ThreadKilled) {
        return (2, TO_W_(StgTSO_id(tso)));
    }
    return (1, TO_W_(StgTSO_id(tso)));
}


#if SIZEOF_W == 8

// -----------------------------------------------------------------------
// stg_readSlot
//
// (key, cell) read of one slot; see the note above.
//
// Returns: (Int64# key, Weak# cell)
// -----------------------------------------------------------------------

stg_readSlot(P_ keys, P_ cells, W_ slot)
{
    W_ key;
    P_ cell;

    (key) = prim %load_acquire64(KEY_ADDR(keys, slot));
    cell = P_[CELL_ADDR(cells, slot)];
    return (key, cell);
}


// -----------------------------------------------------------------------
// PROBE_BODY
//
// Shared by both probes. Expects `keys`, `cells`, `mask`, `tid` and the
// locals `home`, `slot`, `key`, `cell`, `info`, `var`. Each RETURN_*
// macro is supplied by the caller so the two probes can return different
// tuples.
//
//   attached, cell alive -> RETURN_FOUND(slot, key, var), var the MutVar#
//   detached, cell alive -> RETURN_DETACHED(slot, key, var)
//   absent, mid-claim, or the thread's cell is dead -> RETURN_MISS
//
// A slot is only ever claimed from a state with no attached value (empty,
// detached, or holding a dead cell), and the claim publishes the new
// state atomically. A probe that meets a claim in flight therefore
// reports the state before it, a miss, instead of waiting: it never
// spins, so it needs no safepoint, and a writer that gets the miss goes to
// the Haskell insert path, which waits for the claim with a yield.
//
// A dead cell under a live key means the slot was tombstoned or its cell
// replaced after the key was read, or that the thread is gone. The key is
// read again: if it changed, the slot is examined afresh; if not, the
// thread is gone and the probe reports a miss. A WHITEHOLE cell is being
// finalized, which only happens to a cell after its key is tombstoned (or
// to a map's cells once the map itself is unreachable), so it takes the
// same path.
//
// The likely annotations lay out an attached hit on the home slot as the
// fall-through path.
// -----------------------------------------------------------------------

#define PROBE_BODY                                                         \
    home = (tid * HASH_SALT) & mask;                                       \
    slot = home;                                                           \
  again:                                                                   \
    (key) = prim %load_acquire64(KEY_ADDR(keys, slot));                    \
    if ((key & KEY_MASK) == tid) (likely: True) {                          \
        if ((key & (CLAIMING_BIT | DETACHED_BIT)) != 0) (likely: False) {  \
            if ((key & CLAIMING_BIT) != 0) {                               \
                RETURN_MISS;                                               \
            }                                                              \
            cell = P_[CELL_ADDR(cells, slot)];                             \
            info = GET_INFO_ACQUIRE(cell);                                 \
            if (info == stg_WEAK_info) {                                   \
                var = StgWeak_value(cell);                                 \
                updateRemembSetPushPtr(var);                               \
                RETURN_DETACHED(slot, key, var);                           \
            }                                                              \
            goto dead;                                                     \
        }                                                                  \
        cell = P_[CELL_ADDR(cells, slot)];                                 \
        info = GET_INFO_ACQUIRE(cell);                                     \
        if (info == stg_WEAK_info) (likely: True) {                        \
            var = StgWeak_value(cell);                                     \
            updateRemembSetPushPtr(var);                                   \
            RETURN_FOUND(slot, key, var);                                  \
        }                                                                  \
        goto dead;                                                         \
    }                                                                      \
    if (key == 0 || key == FROZEN_BIT) {                                   \
        RETURN_MISS;                                                       \
    }                                                                      \
    slot = (slot + 1) & mask;                                              \
    if (slot != home) {                                                    \
        goto again;                                                        \
    }                                                                      \
    RETURN_MISS;                                                           \
  dead:                                                                    \
    if (W_[KEY_ADDR(keys, slot)] != key) {                                 \
        goto again;                                                        \
    }                                                                      \
    RETURN_MISS;


// -----------------------------------------------------------------------
// stg_probeThreadSlot
//
// Fused thread ID retrieval + multiplicative-hash linear probe + cell
// read, for the current thread.
//
// Arguments:
//   P_ keys  : MutableByteArray# of 64-bit keys
//   P_ cells : MutableArray# of cells
//   W_ mask  : table capacity - 1
//
// Returns: (Int64# tid, Int# slot, Int64# key, MutVar# var)
//   tid is masked to KEY_MASK, the form in which keys are stored.
//   slot >= 0   -> entry found and attached; key is the word observed
//                  there and var the MutVar# behind its live cell
//   slot == -1  -> no live entry; key is 0, var a placeholder (keys)
//   slot <= -2  -> entry found but detached; real index = -(slot+2);
//                  key is the observed word and var the MutVar# behind
//                  its live cell
// -----------------------------------------------------------------------

stg_probeThreadSlot(P_ keys, P_ cells, W_ mask)
{
    W_ tid, home, slot, key, info;
    P_ cell, var;

    tid = TO_W_(StgTSO_id(CurrentTSO)) & KEY_MASK;

#define RETURN_FOUND(s, k, v)  return (tid, s, k, v)
#define RETURN_DETACHED(s, k, v)  return (tid, 0 - (s) - 2, k, v)
#define RETURN_MISS            return (tid, -1, 0, keys)
    PROBE_BODY
#undef RETURN_FOUND
#undef RETURN_DETACHED
#undef RETURN_MISS
}


// -----------------------------------------------------------------------
// stg_probeSlotByKey
//
// The same probe for an explicit key, already masked to KEY_MASK.
// Used by lookupRaw / updateRaw / the OnThread functions.
//
// Returns: (Int# slot, Int64# key, MutVar# var)  (encoding as above)
// -----------------------------------------------------------------------

stg_probeSlotByKey(P_ keys, P_ cells, W_ mask, W_ tid)
{
    W_ home, slot, key, info;
    P_ cell, var;

#define RETURN_FOUND(s, k, v)  return (s, k, v)
#define RETURN_DETACHED(s, k, v)  return (0 - (s) - 2, k, v)
#define RETURN_MISS            return (-1, 0, keys)
    PROBE_BODY
#undef RETURN_FOUND
#undef RETURN_DETACHED
#undef RETURN_MISS
}

#endif
